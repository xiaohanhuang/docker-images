            "id": "3067429022",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"GithubOidcAuth\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"sts:TagSession\",\n        \"sts:AssumeRoleWithWebIdentity\"\n      ],\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::805673386114:oidc-provider/token.actions.githubusercontent.com\"\n      },\n      \"Condition\": {\n        \"ForAllValues:StringEquals\": {\n          \"token.actions.githubusercontent.com:aud\": \"sts.amazonaws.com\",\n          \"token.actions.githubusercontent.com:iss\": \"https://token.actions.githubusercontent.com\"\n        },\n        \"StringLike\": {\n          \"token.actions.githubusercontent.com:sub\": [\n            \"repo:xiaohanhuang/ml-platform:*\",\n            \"repo:xiaohanhuang/docker-images:*\"\n          ]\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"GithubOidcAuth\",\"Effect\":\"Allow\",\"Action\":[\"sts:TagSession\",\"sts:AssumeRoleWithWebIdentity\"],\"Principal\":{\"Federated\":\"arn:aws:iam::805673386114:oidc-provider/token.actions.githubusercontent.com\"},\"Condition\":{\"ForAllValues:StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:iss\":\"https://token.actions.githubusercontent.com\"},\"StringLike\":{\"token.actions.githubusercontent.com:sub\":[\"repo:xiaohanhuang/ml-platform:*\",\"repo:xiaohanhuang/docker-images:*\"]}}}]}",
