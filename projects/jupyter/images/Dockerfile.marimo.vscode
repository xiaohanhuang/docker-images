# Image that adds VS Code Server on top of the Marimo-enabled image
FROM 805673386114.dkr.ecr.us-west-2.amazonaws.com/ml-platform/notebook-marimo:latest

USER root

# Install code-server
RUN curl -fsSL https://code-server.dev/install.sh | sh

USER ${NB_UID}

# VS Code proxy entry (registers VS Code in JupyterLab launcher)
COPY --chown=${NB_UID}:${NB_GID} projects/jupyter/images/vscode_proxy /opt/vscode-proxy/
RUN pip install --no-cache-dir --no-deps /opt/vscode-proxy/

EXPOSE 8888
